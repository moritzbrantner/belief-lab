# belief-lab policy is fail-closed. Copy this file to .env for local runners.
# Environment allowlists may narrow a profile but never widen it.

BELIEF_POLICY_PROFILE=semantic_research

# Evidence classes this process may consume.
BELIEF_ALLOWED_EVIDENCE=user_assertion,metadata,transcript,ocr,object_detection,scene_detection,named_entity

# How accepted evidence may participate in inference.
BELIEF_ALLOWED_EVIDENCE_PURPOSES=direct_support,corroboration

# Inference classes this process may execute.
BELIEF_ALLOWED_INFERENCES=descriptive,preference

# High-risk capabilities require separate opt-ins even when the selected profile
# has them in its maximum capability set.
BELIEF_BIOMETRIC_EVIDENCE=off
BELIEF_IDENTITY_RESOLUTION=disabled
BELIEF_ALLOW_CROSS_SOURCE_JOIN=false

# This setting is currently mandatory and cannot be disabled.
BELIEF_REQUIRE_COMPLETE_PROVENANCE=true

# Multimodal research example (deliberately commented out):
# BELIEF_POLICY_PROFILE=multimodal_research
# BELIEF_ALLOWED_EVIDENCE=user_assertion,metadata,transcript,ocr,object_detection,scene_detection,named_entity,face_track_reference,voice_track_reference
# BELIEF_ALLOWED_EVIDENCE_PURPOSES=direct_support,corroboration,entity_linking
# BELIEF_ALLOWED_INFERENCES=descriptive,preference,local_entity_link,cross_source_association
# BELIEF_BIOMETRIC_EVIDENCE=reference_only
# BELIEF_IDENTITY_RESOLUTION=corpus_local
# BELIEF_ALLOW_CROSS_SOURCE_JOIN=true
